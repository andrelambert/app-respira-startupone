# Copie para backend/.env e preencha. O .env NUNCA entra no Git (docs/contexto-produto.md §12).
# Depois de editar, reinicie o backend (a configuração é lida na subida).

APP_PUBLIC_URL=http://localhost:5173
APP_TERMS_URL=https://exemplo.com/termos
DATABASE_URL=sqlite:///./respira.db

# --- Oracle Autonomous AI Database (opcional; sem isto, SQLite) ---
# Para usar o Oracle: DATABASE_URL=oracle+oracledb://@ e as variáveis abaixo.
# A wallet (tnsnames.ora + ewallet.pem) fica FORA do repositório; senhas nunca no Git.
# Montagem do banco, usuários e wallet: ops/oracle/ (scripts) e configurar_env.py.
ORACLE_USER=
ORACLE_PASSWORD=
# Alias do tnsnames.ora, ex.: respira_tp
ORACLE_DSN=
# Pasta com tnsnames.ora e ewallet.pem (no Render: /etc/secrets)
ORACLE_CONFIG_DIR=
ORACLE_WALLET_PASSWORD=
ORACLE_POOL_SIZE=3
ORACLE_REGIAO=sa-saopaulo-1
LOG_LEVEL=INFO

# --- Belvo: contas reais (toda conta registrada no app usa a Belvo) ---
# Produção: https://api.belvo.com · Sandbox: https://sandbox.belvo.com
BELVO_BASE_URL=https://api.belvo.com
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_WIDGET_URL=https://widget.belvo.io
# fetch_resources: OWNERS, ACCOUNTS, TRANSACTIONS, BILLS + INCOMES, RECURRING_EXPENSES.
# Se o token falhar porque a conta não tem os add-ons, troque para false.
BELVO_ENRICHMENT_ENABLED=true
# Webhook só funciona com URL pública (ngrok/Cloudflare Tunnel) registrada no
# dashboard da Belvo. Com false, a coleta é feita por polling (§7.5).
BELVO_WEBHOOKS_ENABLED=false
# Valor que a Belvo envia em "Authorization: Bearer <token>". Vazio = todo webhook recusado.
BELVO_WEBHOOK_TOKEN=

# --- Conta de demonstração (Juliana — persona e dados fictícios, não é segredo) ---
DEMO_HABILITADA=true
DEMO_EMAIL=juliana@respira.example
DEMO_SENHA=senha123
FIXTURE_COLETA_SEGUNDOS=2

# --- Versão pública (M5) — Render ---
# MODO_PUBLICO=true: Belvo desligada mesmo com chaves, cadastro sem CPF, faixa de aviso, noindex.
MODO_PUBLICO=false
# DEMO_POR_VISITANTE=true: "Entrar como Juliana" cria uma Juliana só do visitante,
# apagada com todos os dados depois de DEMO_VALIDADE_HORAS.
DEMO_POR_VISITANTE=false
DEMO_VALIDADE_HORAS=24
DEMO_MAX_ATIVAS=200
DEMO_POR_IP_HORA=10

# --- CPF criptografado em repouso (M6) ---
# Chave Fernet. Gere com:
#   uv run --with cryptography python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem ela, o cadastro com CPF (necessário para conectar banco real) é recusado.
# Guarde-a: perdida, os CPFs cifrados não podem mais ser lidos.
CPF_CHAVE=
