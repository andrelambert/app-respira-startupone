# Copie para backend/.env e preencha. O .env NUNCA entra no Git (docs/contexto-produto.md §12).
# Depois de editar, reinicie o backend (a configuração é lida na subida).

APP_PUBLIC_URL=http://localhost:5173
APP_TERMS_URL=https://exemplo.com/termos
DATABASE_URL=sqlite:///./respira.db
LOG_LEVEL=INFO

# --- Belvo: contas reais (toda conta registrada no app usa a Belvo) ---
# Produção: https://api.belvo.com · Sandbox: https://sandbox.belvo.com
BELVO_BASE_URL=https://api.belvo.com
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_WIDGET_URL=https://widget.belvo.io
# fetch_resources: OWNERS, ACCOUNTS, TRANSACTIONS, BILLS + INCOMES, RECURRING_EXPENSES.
# Se o token falhar porque a conta não tem os add-ons, troque para false.
BELVO_ENRICHMENT_ENABLED=true
# Webhook só funciona com URL pública (ngrok/Cloudflare Tunnel) registrada no
# dashboard da Belvo. Com false, a coleta é feita por polling (§7.5).
BELVO_WEBHOOKS_ENABLED=false
# Valor que a Belvo envia em "Authorization: Bearer <token>". Vazio = todo webhook recusado.
BELVO_WEBHOOK_TOKEN=

# --- Conta de demonstração (Juliana — persona e dados fictícios, não é segredo) ---
DEMO_HABILITADA=true
DEMO_EMAIL=juliana@respira.example
DEMO_SENHA=senha123
FIXTURE_COLETA_SEGUNDOS=2
